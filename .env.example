# RC-API v1.0 Environment Variables
# Copy to .env and fill in values before running.

# ── Required ──────────────────────────────────────────────────────────────────
# External clinical FHIR server (patient data source)
EXTERNAL_FHIR_SERVER_URL=https://your-fhir-server.example.com/fhir/

# HAPI FHIR server used for CQL execution + resource management (Questionnaire, Library, Group)
HAPI_FHIR_CQL_EXECUTION_URL=https://your-hapi-fhir.example.com/fhir/

# ── FHIR Auth (optional) ──────────────────────────────────────────────────────
# Bearer token or Basic auth for the external FHIR server (entire "Authorization" header value)
# EXTERNAL_FHIR_SERVER_AUTH=Bearer <token>

# ── LiteLLM (all three required for LLM/unstructured logic) ───────────────────
# LITELLM_MODEL=openai/gpt-4o
# LITELLM_API_BASE=https://your-litellm-proxy.example.com
# LITELLM_API_KEY=<key>
# Optional reasoning effort, forwarded for models that support it (e.g. low, medium, high)
# LITELLM_MODEL_REASONING_EFFORT=high
# Enable provider-side prompt caching for supported models (default true)
# LITELLM_PROMPT_CACHE_ENABLED=true

# Max concurrent in-flight LLM calls per job (default 8)
# LLM_MAX_CONCURRENCY=8
# Max concurrent in-flight CQL library evaluations across batch jobs (default 4)
# CQL_MAX_CONCURRENCY=4
# Max concurrent DocumentReference attachment fetches (default 8)
# DOC_FETCH_MAX_CONCURRENCY=8

# ── Embedded durable batch worker ─────────────────────────────────────────────
# Run the database-backed worker inside this API process (default true)
# BATCH_WORKER_ENABLED=true
# Seconds between checks for runnable or expired jobs (default 2)
# BATCH_WORKER_POLL_INTERVAL_SECONDS=2
# Seconds a claimed batch remains owned without renewal (default 120)
# BATCH_WORKER_LEASE_SECONDS=120
# Seconds between lease heartbeat renewals while a batch is executing (default 30)
# BATCH_JOB_HEARTBEAT_INTERVAL_SECONDS=30
# Minimum seconds between partial Bundle checkpoint writes (default 5; 0 writes every task)
# BATCH_JOB_CHECKPOINT_INTERVAL_SECONDS=5.0
# Minimum task completions between partial Bundle checkpoint writes (default 10)
# BATCH_JOB_CHECKPOINT_EVERY_TASKS=10
# Maximum execution attempts before a batch becomes terminal error (default 3)
# BATCH_JOB_MAX_ATTEMPTS=3
# Seconds before a failed or expired attempt becomes runnable again (default 30)
# BATCH_JOB_RETRY_DELAY_SECONDS=30

# ── Langfuse (all three required; falls back to ./prompts/ if not set) ─────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# Provider-managed LiteLLM/OpenTelemetry GenAI convention opt-in
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# Maximum seconds for one Langfuse prompt fetch attempt (default 5)
# LANGFUSE_PROMPT_FETCH_TIMEOUT_SECONDS=5
# Retries after a failed Langfuse prompt fetch (default 1)
# LANGFUSE_PROMPT_MAX_RETRIES=1
# Application Langfuse prompt cache lifetime in seconds (default 60; 0 disables caching)
# LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60.0
# Maximum concurrent Langfuse prompt fetches across batch jobs (default 4)
# LANGFUSE_PROMPT_FETCH_CONCURRENCY=4

# ── Prompts (local fallback path when Langfuse not configured) ─────────────────
# PROMPTS_DIR=./prompts

# ── OAuth 2 (REQUIRED unless AUTH_DISABLED=true) ──────────────────────────────
# Authentication fails closed: if any of these three is missing, protected
# endpoints return 503. All three are validated on every token (signature, iss, aud, exp).
OAUTH2_JWKS_URL=https://your-auth-server.example.com/.well-known/jwks.json
OAUTH2_ISSUER=https://your-auth-server.example.com/
OAUTH2_AUDIENCE=rc-api
# Seconds to cache the JWKS before refetching (default 3600; unknown key ids also trigger a refresh)
# OAUTH2_JWKS_CACHE_SECONDS=3600
# Local development ONLY — disables authentication entirely. Never set in production.
# AUTH_DISABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Unset = no CORS headers.
# CORS_ALLOW_ORIGINS=https://smartchart.example.org,http://localhost:3000

# ── DocumentReference attachments (SSRF protection & limits) ───────────────────
# Attachment URLs are fetched only from the EXTERNAL_FHIR_SERVER_URL origin and these
# extra hosts (comma-separated; prefix with "." to include subdomains). Private/loopback/
# link-local IP literals are always rejected.
# ATTACHMENT_ALLOWED_HOSTS=docs.example.org,.blobstore.example.org
# Max DocumentReferences processed per patient (default 500)
# DOC_MAX_COUNT=500
# Max bytes per attachment, inline or fetched (default 5000000)
# DOC_MAX_BYTES=5000000

# ── Database ──────────────────────────────────────────────────────────────────
# DB_CONNECTION_STRING=postgresql+psycopg://user:pass@db-host/rcapi
DB_CONNECTION_STRING=sqlite+pysqlite:///rcapi_jobs.sqlite
# DB_SCHEMA=rcapi

# ── Misc ──────────────────────────────────────────────────────────────────────
# DEPLOY_URL=http://example.org/
# PRIMARYIDENTIFIER_SYSTEM=http://example.org/fhir/identifier-system
# PRIMARYIDENTIFIER_LABEL=Primary Identifier
# LOG_LEVEL=INFO
