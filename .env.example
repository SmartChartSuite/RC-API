# RC-API v1.0 Environment Variables
# Copy to .env and fill in values before running.

# ── Required ──────────────────────────────────────────────────────────────────
# External clinical FHIR server (patient data source)
EXTERNAL_FHIR_SERVER_URL=https://your-fhir-server.example.com/fhir/

# HAPI FHIR server used for CQL execution + resource management (Questionnaire, Library, Group)
HAPI_FHIR_CQL_EXECUTION_URL=https://your-hapi-fhir.example.com/fhir/

# ── FHIR Auth (optional) ──────────────────────────────────────────────────────
# Bearer token or Basic auth for the external FHIR server (entire "Authorization" header value)
# EXTERNAL_FHIR_SERVER_AUTH=Bearer <token>

# ── LiteLLM (all three required for LLM/unstructured logic) ───────────────────
# LITELLM_MODEL=openai/gpt-4o
# LITELLM_API_BASE=https://your-litellm-proxy.example.com
# LITELLM_API_KEY=<key>

# Max concurrent in-flight LLM calls per job (default 8)
# LLM_MAX_CONCURRENCY=8
# Max concurrent DocumentReference attachment fetches (default 8)
# DOC_FETCH_MAX_CONCURRENCY=8

# ── Embedded durable batch worker ─────────────────────────────────────────────
# Run the database-backed worker inside this API process (default true)
# BATCH_WORKER_ENABLED=true
# Seconds between checks for runnable or expired jobs (default 2)
# BATCH_WORKER_POLL_INTERVAL_SECONDS=2
# Seconds a claimed batch remains owned without renewal (default 120)
# BATCH_WORKER_LEASE_SECONDS=120
# Seconds between lease heartbeat renewals while a batch is executing (default 30)
# BATCH_JOB_HEARTBEAT_INTERVAL_SECONDS=30
# Maximum execution attempts before a batch becomes terminal error (default 3)
# BATCH_JOB_MAX_ATTEMPTS=3
# Seconds before a failed or expired attempt becomes runnable again (default 30)
# BATCH_JOB_RETRY_DELAY_SECONDS=30

# ── Langfuse (all three required; falls back to ./prompts/ if not set) ─────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Prompts (local fallback path when Langfuse not configured) ─────────────────
# PROMPTS_DIR=./prompts

# ── OAuth 2 (optional; all endpoints are open if not set) ─────────────────────
# OAUTH2_JWKS_URL=https://your-auth-server.example.com/.well-known/jwks.json
# OAUTH2_ISSUER=https://your-auth-server.example.com/
# OAUTH2_AUDIENCE=rc-api

# ── Database ──────────────────────────────────────────────────────────────────
# DB_CONNECTION_STRING=postgresql+psycopg2://user:pass@db-host/rcapi
DB_CONNECTION_STRING=sqlite+pysqlite:///rcapi_jobs.sqlite
# DB_SCHEMA=rcapi

# ── Misc ──────────────────────────────────────────────────────────────────────
# DEPLOY_URL=http://example.org/
# PRIMARYIDENTIFIER_SYSTEM=http://example.org/fhir/identifier-system
# PRIMARYIDENTIFIER_LABEL=Primary Identifier
# LOG_LEVEL=INFO
