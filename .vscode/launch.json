    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "hypercorn",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "--reload",
                "main:app",
                "--config",
                "hypercorn_config.toml"
            ],
            "jinja": true,
            "justMyCode": false
        }
    ]
}
